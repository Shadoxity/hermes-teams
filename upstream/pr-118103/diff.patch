+def _fence_channel_text(text: str, *, language: str = "") -> str:
+    """Wrap ``text`` in a markdown fence that cannot collide with its contents."""
+    fence = "```"
+    while fence in text:
+        fence += "`"
+    info = language if language and all(ch.isalnum() or ch in "-_+" for ch in language) else ""
